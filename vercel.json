{
    "version": 2,
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.py"
        }
    ],
    "events": [],
    "properties": [
        {
            "valueType": {
                "type": "signed"
            },
            "id": "...",
            "name": "...",
            "expands": {
                "isShowCurve": 1
            }
        }
    ],
    "functions": [],
    "tags": []
} 